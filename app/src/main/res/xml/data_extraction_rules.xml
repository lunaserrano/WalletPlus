<?xml version="1.0" encoding="utf-8"?>
<!-- Privacidad: la base de datos financiera no se copia a la nube ni a otros dispositivos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
